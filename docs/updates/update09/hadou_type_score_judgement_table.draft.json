{
  "schemaVersion": "draft-2026-06-28",
  "kind": "type_score_evidence_normalization_spec",
  "principles": [
    "評価スコアはタグ一致ではなく、現在部隊で発生する一次効果を正規化した scoreEvidence を入力にする。",
    "型要素、検索タグ、関連リンクタグ、変化率集計、結果サマリー、パラメータ集計は直接加点しない。",
    "targetScope は必要条件であり十分条件ではない。必ず effectFamily / effectKind / sourceOrigin / dependency と組み合わせる。",
    "primary が0なら support だけで高得点にしない。",
    "同一起源の効果は evidenceGroupKey で代表化し、派生タグや集計値で二重加点しない。"
  ],
  "scoreEvidenceFields": {
    "evidenceId": "stable unique id",
    "sourceType": [
      "general",
      "tactic",
      "skill",
      "equipment",
      "formation",
      "siegeWeapon",
      "ethnicArmament",
      "ethnicResearchSkill",
      "fiveElement",
      "warhorse",
      "warhorseSkill"
    ],
    "sourceId": "source master id/name",
    "sourceLabel": "display source label",
    "sourceSlot": [
      "main",
      "vice1",
      "vice2",
      "support1",
      "support2",
      "attendant",
      "equipment",
      "formation",
      "fiveElement",
      "warhorse"
    ],
    "timing": [
      "always",
      "tactic_activated",
      "combat_start",
      "on_attack",
      "on_damaged",
      "on_chain",
      "on_garrison",
      "conditional"
    ],
    "conditionText": "raw condition",
    "targetScope": [
      "self",
      "ally",
      "enemy",
      "unknown"
    ],
    "targetCount": "number or null",
    "effectKind": [
      "buff",
      "debuff",
      "recovery",
      "defense",
      "disadvantage_counter",
      "gauge",
      "chain",
      "range",
      "damage",
      "anti_object",
      "survival",
      "buff_protection",
      "utility"
    ],
    "effectFamily": "canonical family such as attack_up, weakening_remove, tactic_speed",
    "value": "number or null",
    "unit": [
      "%",
      "count",
      "second",
      "presence",
      "unknown"
    ],
    "duration": "seconds or null",
    "isPrimaryEffect": "true only for real effect from source text/structured source",
    "isDerivedTag": "true for search/type/status derived tags",
    "isAggregateMetric": "true for parameter summary / rate summary / result summary",
    "evidenceGroupKey": "sourceType|sourceId|sourceSlot|timing|targetScope|effectFamily|conditionText",
    "rawText": "original effect text"
  },
  "effectFamilyCatalog": {
    "buff": [
      "attack_up",
      "defense_up",
      "intelligence_up",
      "tactic_power_up",
      "normal_attack_power_up",
      "attack_speed_up",
      "critical_rate_up",
      "critical_power_up",
      "critical_tactic_rate_up",
      "critical_tactic_power_up",
      "normal_attack_target_count_up",
      "range_up",
      "anti_object_up"
    ],
    "debuff": [
      "enemy_attack_down",
      "enemy_defense_down",
      "enemy_anti_object_down",
      "tactic_delay",
      "chain_nullify_to_enemy",
      "confuse",
      "fear",
      "severance",
      "isolation"
    ],
    "disadvantageCounter": [
      "weakening_nullify",
      "weakening_remove",
      "weakening_avoid",
      "status_nullify",
      "status_remove",
      "severance_counter",
      "isolation_counter",
      "chain_nullify_counter",
      "control_counter"
    ],
    "survival": [
      "troops_up",
      "wounded_recovery",
      "wounded_survival",
      "annihilation_avoidance",
      "damage_reduction",
      "attribute_resistance",
      "healing",
      "continuous_healing"
    ],
    "tempo": [
      "tactic_speed",
      "tactic_reduction",
      "initial_tactic_gauge",
      "combat_start_tactic_gauge",
      "chain_rate"
    ]
  },
  "exclusionRules": [
    {
      "id": "exclude_aggregate",
      "condition": "isAggregateMetric == true",
      "reason": "集計値は結果であり根拠ではない"
    },
    {
      "id": "exclude_derived",
      "condition": "isDerivedTag == true && isPrimaryEffect != true",
      "reason": "派生タグは直接加点しない"
    },
    {
      "id": "exclude_unknown_target",
      "condition": "targetScope == unknown for target-dependent metrics",
      "reason": "対象不明は対象依存評価では加点しない"
    },
    {
      "id": "exclude_enemy_for_ally",
      "condition": "targetScope == enemy for ally/self metrics",
      "reason": "敵対象は味方/自部隊評価から除外"
    },
    {
      "id": "exclude_plain_buff_for_vaccine",
      "condition": "typeId == vaccine && effectFamily in plain buff/survival/tempo/attributeResistance",
      "reason": "ワクチン型は弱化/状態異常/制御対策のみ"
    },
    {
      "id": "exclude_support_without_primary",
      "condition": "all primaryMetrics score 0",
      "reason": "補助項目だけで型成立としない"
    }
  ],
  "typeJudgementTable": [
    {
      "typeId": "calm",
